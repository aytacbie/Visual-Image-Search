# Copy to .env to override defaults. Never commit .env.

# Embedder: onnx (local, default) or nvclip (needs NVIDIA_API_KEY; falls back to onnx)
# VS_EMBEDDER=onnx
# NVIDIA_API_KEY=nvapi-...

# Extra API keys as label:scope:sha256 joined with ';' (printed by scripts/create_api_key.py)
# VS_API_KEYS=

# VS_CORS_ORIGINS=https://my-domain.com
# VS_PUBLIC_BASE_URL=
# VS_MAX_UPLOAD_MB=10
# VS_DEFAULT_TOP_K=5
# VS_MAX_TOP_K=50
# VS_HNSW_THRESHOLD=50000
# VS_RATE_LIMIT_PER_MINUTE=120
# VS_WEB_RATE_LIMIT_PER_MINUTE=20
# VS_THREADS=0
# VS_INGEST_ON_STARTUP=1
